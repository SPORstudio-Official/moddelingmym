{
  "name": "colony-ant-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first ant colony learning simulation desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "build": {
    "appId": "ai.arena.colonylab",
    "productName": "Colony",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "style.css",
      "sim.js",
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Colony.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
