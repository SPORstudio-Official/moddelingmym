{
  "name": "wonderworks",
  "version": "1.0.0",
  "description": "A creativity arcade for making wonderfully unexpected ideas.",
  "author": "SPORstudio Official",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "check": "node --check game.js && node --check electron/main.cjs && node --check test/smoke.cjs",
    "test": "node test/smoke.cjs"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "minimatch@^10.2.5": "11.0.5",
    "minimatch@^9.0.3": "11.0.5"
  },
  "build": {
    "appId": "com.sporstudio.wonderworks",
    "productName": "Wonderworks",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "style.css",
      "game.js",
      "assets/**",
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Wonderworks.exe"
    },
    "portable": {
      "artifactName": "Wonderworks.exe"
    }
  }
}
