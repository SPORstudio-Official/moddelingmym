# Electron fetches its runtime binary from GitHub's release-asset host during
# postinstall.  A network that blocks that host (some CI sandboxes, corporate
# proxies) would otherwise fail the *entire* install and leave no electron
# package at all -- even though the shell source needs nothing from it until
# launch.  Skipping the download lets `npm install` finish; run
# `npm run fetch-electron` once on a normal network to pull the binary.
electron_skip_binary_download=1
