#include <windows.h>

1 ICON "assets/deadair.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          0x40004L
FILETYPE        0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "SPOR Studio"
            VALUE "FileDescription",  "DEAD AIR - an auditory haunting"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "deadair"
            VALUE "OriginalFilename", "DEAD AIR.exe"
            VALUE "ProductName",      "DEAD AIR"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
